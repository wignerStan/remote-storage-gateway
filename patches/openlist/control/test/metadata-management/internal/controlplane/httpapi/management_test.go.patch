+func TestRcloneRegisteredRoutesCredentialsAndProjection(t *testing.T) {
+	var calls atomic.Int32
+	var stopped atomic.Bool
+	rc := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		u, p, ok := r.BasicAuth()
+		if !ok || u != "operator" || p != "test-password" {
+			t.Error("secret reference not applied")
+			w.WriteHeader(401)
+			return
+		}
+		if r.Method != "POST" {
+			t.Error("wrong RC method")
+		}
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/core/version":
+			io.WriteString(w, `{"version":"v1.71.2","os":"linux","arch":"amd64","password":"never-return-this"}`)
+		case "/core/stats":
+			b, _ := io.ReadAll(r.Body)
+			if string(b) != `{"short":true}` {
+				t.Errorf("not short stats: %s", b)
+			}
+			io.WriteString(w, `{"bytes":42,"errors":1,"lastError":"never-return-this","transferring":[{"name":"private"}]}`)
+		case "/job/list":
+			io.WriteString(w, `{"executeId":"process-one","jobids":[7],"running_ids":[7],"finished_ids":[]}`)
+		case "/job/status":
+			io.WriteString(w, `{"id":7,"executeId":"process-one","finished":false,"success":false,"error":"never-return-this","output":{"password":"never-return-this"}}`)
+		case "/job/stop":
+			stopped.Store(true)
+			io.WriteString(w, `{}`)
+		default:
+			t.Error("unregistered RC method reached", r.URL.Path)
+			w.WriteHeader(500)
+		}
+	}))
+	defer rc.Close()
+	passwordPath := secretFile(t, "test-password")
+	registry, e := cp.New(cp.Config{Targets: []cp.Target{{Name: "backup", Kind: "rclone", Endpoint: rc.URL, Username: "operator", PasswordSecretRef: "rc-password"}}, SecretFiles: map[string]string{"rc-password": passwordPath}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	routes := router(registry)
+	summary := request(t, routes, "GET", "/targets", "")
+	if calls.Load() != 0 || strings.Contains(summary.Body.String(), "test-password") || strings.Contains(summary.Body.String(), rc.URL) {
+		t.Fatal("target inventory initialized provider or disclosed endpoint credentials")
+	}
+	for _, route := range []string{"version", "stats", "jobs", "jobs/7"} {
+		w := request(t, routes, "GET", "/targets/backup/"+route, "")
+		if w.Code != 200 || strings.Contains(w.Body.String(), "never-return-this") || strings.Contains(w.Body.String(), "private") {
+			t.Fatalf("unsafe %s response %d %s", route, w.Code, w.Body)
+		}
+	}
+	w := request(t, routes, "POST", "/targets/backup/jobs/7/stop", `{"execute_id":"old-process"}`)
+	if w.Code != 409 || stopped.Load() {
+		t.Fatal("stale job submission stopped a current process job")
+	}
+	w = request(t, routes, "POST", "/targets/backup/jobs/7/stop", `{"execute_id":"process-one"}`)
+	if w.Code != 200 || !stopped.Load() {
+		t.Fatal("typed job stop failed", w.Code, w.Body)
+	}
+	before := calls.Load()
+	for _, route := range []string{"config/dump", "rc/noop", "operations/cat", "operations/put", "sync/sync", "jobs/not-a-number"} {
+		w = request(t, routes, "GET", "/targets/backup/"+route, "")
+		if w.Code < 400 {
+			t.Fatal("undeclared operation admitted", route)
+		}
+	}
+	w = request(t, routes, "POST", "/targets/backup/jobs/7/stop", `{"execute_id":"process-one","url":"http://untrusted"}`)
+	if w.Code != 400 || calls.Load() != before {
+		t.Fatal("unknown fields or arbitrary RC operation reached endpoint")
+	}
+	if e = os.Chmod(passwordPath, 0644); e != nil {
+		t.Fatal(e)
+	}
+	w = request(t, routes, "GET", "/targets/backup/version", "")
+	if w.Code != 502 || calls.Load() != before {
+		t.Fatal("invalid secret permissions fell back to anonymous endpoint access")
+	}
+
+}
