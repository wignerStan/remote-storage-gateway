+func secretFile(t *testing.T, value string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "secret")
+	if e := os.WriteFile(p, []byte(value), 0600); e != nil {
+		t.Fatal(e)
+	}
+	return p
+}
+func fixtureAPI(r *cp.Registry) *gin.Engine {
+	entry := httpapi.NewEntry(r, nil)
+	table, err := schemaapi.Compose(httpapi.APIConfig(), entry.RegisterRoutes)
+	if err != nil {
+		panic(err)
+	}
+	engine, err := openapigin.New(table, openapigin.Options{Prefix: "/api/admin/control", OpenAPIPath: "/openapi", SchemasPath: "/schemas", Errors: httpapi.ErrorPolicy()})
+	if err != nil {
+		panic(err)
+	}
+	return engine
+}
+func router(r *cp.Registry) http.Handler {
+	return fixtureAPI(r)
+}
+func request(t *testing.T, r http.Handler, method, path, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	q := httptest.NewRequest(method, "/api/admin/control"+path, strings.NewReader(body))
+	q.Header.Set("Content-Type", "application/json")
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, q)
+	return w
+}
