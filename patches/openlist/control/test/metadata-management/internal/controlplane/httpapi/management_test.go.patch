+func TestRegistryRejectsUnsafeTargetsAndPayloadFields(t *testing.T) {
+	for _, target := range []cp.Target{
+		{Name: "bad", Kind: "rclone", Endpoint: "http://user:password@example.test"},
+		{Name: "bad", Kind: "rclone", Endpoint: "http://example.test?url=http://other"},
+		{Name: "bad", Kind: "origin-webdav", Endpoint: "http://example.test", Root: "../private"},
+		{Name: "bad", Kind: "origin-s3", Endpoint: "http://example.test", Bucket: "selected", Region: "region"},
+		{Name: "bad", Kind: "arbitrary", Endpoint: "http://example.test"},
+	} {
+		if _, e := cp.New(cp.Config{Targets: []cp.Target{target}}); e == nil {
+			t.Fatal("unsafe operator target accepted", target.Kind)
+		}
+	}
+	for _, body := range []string{`{"targets":[],"targets":[]}`, `{"targets":[{"name":"x","kind":"rclone","endpoint":"http://localhost","password":"inline-secret"}]}`, strings.Repeat(" ", cp.MaxMetadata) + "{}"} {
+		p := filepath.Join(t.TempDir(), "registry")
+		os.WriteFile(p, []byte(body), 0600)
+		if _, e := cp.Load(p); e == nil {
+			t.Fatal("unsafe registry accepted")
+		}
+	}
