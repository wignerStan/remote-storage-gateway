+func TestOriginProbesOnlySignedAvailabilityAndRootMetadata(t *testing.T) {
+	var s3Calls, davCalls atomic.Int32
+	objectStore := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		s3Calls.Add(1)
+		if r.Method != "HEAD" || r.URL.Path != "/approved-bucket" || !strings.HasPrefix(r.Header.Get("Authorization"), "AWS4-HMAC-SHA256 ") {
+			t.Error("probe exceeded selected signed HeadBucket", r.Method, r.URL.Path)
+			w.WriteHeader(500)
+			return
+		}
+		w.WriteHeader(200)
+	}))
+	defer objectStore.Close()
+	fs := &webdav.Handler{FileSystem: webdav.Dir(t.TempDir()), LockSystem: webdav.NewMemLS()}
+	dav := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		davCalls.Add(1)
+		if r.Method != "OPTIONS" && r.Method != "PROPFIND" {
+			t.Error("object payload entered management plane", r.Method)
+			w.WriteHeader(500)
+			return
+		}
+		u, p, _ := r.BasicAuth()
+		if u != "dav-user" || p != "dav-password" {
+			t.Error("DAV secret reference absent")
+			w.WriteHeader(401)
+			return
+		}
+		if r.Method == "PROPFIND" && r.Header.Get("Depth") != "0" {
+			t.Error("probe recursively enumerated objects")
+		}
+		fs.ServeHTTP(w, r)
+	}))
+	defer dav.Close()
+	registry, e := cp.New(cp.Config{Targets: []cp.Target{
+		{Name: "bucket", Kind: "origin-s3", Endpoint: objectStore.URL, Bucket: "approved-bucket", Region: "us-east-1", ForcePathStyle: true, AccessKeySecretRef: "access", SecretKeySecretRef: "key"},
+		{Name: "documents", Kind: "origin-webdav", Endpoint: dav.URL, Username: "dav-user", PasswordSecretRef: "dav"},
+	}, SecretFiles: map[string]string{"access": secretFile(t, "test-access"), "key": secretFile(t, "test-key"), "dav": secretFile(t, "dav-password")}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	routes := router(registry)
+	request(t, routes, "GET", "/targets", "")
+	if s3Calls.Load() != 0 || davCalls.Load() != 0 {
+		t.Fatal("inventory constructed a provider")
+	}
+	for _, name := range []string{"bucket", "documents"} {
+		w := request(t, routes, "GET", "/targets/"+name+"/probe", "")
+		if w.Code != 200 || !strings.Contains(w.Body.String(), `"available":true`) {
+			t.Fatal("native origin probe failed", w.Code, w.Body)
+		}
+	}
+	if s3Calls.Load() != 1 || davCalls.Load() != 2 {
+		t.Fatalf("unexpected provider operations s3=%d dav=%d", s3Calls.Load(), davCalls.Load())
+	}
+}
