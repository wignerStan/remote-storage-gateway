+func TestWorkerManagementPreservesDescriptorAndCAS(t *testing.T) {
+	generated, e := schema.Derive[FixtureConfiguration]()
+	if e != nil {
+		t.Fatal(e)
+	}
+	configSchema, e := json.Marshal(generated)
+	if e != nil {
+		t.Fatal(e)
+	}
+	d := descriptor.Descriptor{Schema: descriptor.Schema, PluginID: "client.fixture", PluginVersion: "1.0.0", Contract: port.Contract, Runtime: "go", BuildDigest: "sha256:" + strings.Repeat("1", 64), Implementations: []descriptor.Implementation{{ID: "fixture", DisplayName: "Fixture", ConfigSchema: configSchema, Capabilities: []string{"stat"}}}}
+	encoded, e := admission.Encode(d)
+	if e != nil {
+		t.Fatal(e)
+	}
+	var pretty bytes.Buffer
+	if e = json.Indent(&pretty, encoded.Bytes, "", "  "); e != nil {
+		t.Fatal(e)
+	}
+	pretty.WriteByte('\n')
+	record, e := admission.Decode(pretty.Bytes())
+	if e != nil {
+		t.Fatal(e)
+	}
+	var replacement atomic.Int32
+	var tamper atomic.Bool
+	version := pluginruntime.Version{Incarnation: "worker-one", Generation: 1, DescriptorDigest: record.Digest}
+	backend := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case management.ManifestPath:
+			json.NewEncoder(w).Encode(worker.Manifest{Schema: worker.CapabilitySchema, Implementation: "go", Lanes: []string{"l7"}, Controls: []string{management.Contract}, PluginRuntimes: []string{"native"}, BuildDigest: d.BuildDigest, PluginDescriptors: []worker.PluginCapability{{PluginID: d.PluginID, Contract: d.Contract, PluginVersion: d.PluginVersion, DescriptorDigest: record.Digest}}})
+		case management.DescriptorPrefix + record.Digest:
+			w.Write(record.Bytes)
+			if tamper.Load() {
+				w.Write([]byte(" "))
+			}
+		case management.ObservedPath:
+			json.NewEncoder(w).Encode([]pluginruntime.Observed{{Name: "files", Version: version, PluginID: d.PluginID, ImplementationID: "fixture", Accepting: true}})
+		case management.ClientPrefix + "files":
+			if r.Method != "POST" {
+				t.Error("wrong replacement method")
+			}
+			var req management.ReplaceRequest
+			json.NewDecoder(r.Body).Decode(&req)
+			if req.Expected != version {
+				w.WriteHeader(409)
+				io.WriteString(w, `{"error":"never-return-this"}`)
+				return
+			}
+			replacement.Add(1)
+			next := version
+			next.Generation++
+			json.NewEncoder(w).Encode(next)
+		default:
+			w.WriteHeader(404)
+		}
+	}))
+	defer backend.Close()
+	registry, e := cp.New(cp.Config{Targets: []cp.Target{{Name: "gateway", Kind: "worker", Endpoint: backend.URL}}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	routes := router(registry)
+	for _, route := range []string{"manifest", "observed"} {
+		w := request(t, routes, "GET", "/targets/gateway/"+route, "")
+		if w.Code != 200 {
+			t.Fatal(route, w.Code, w.Body)
+		}
+	}
+	w := request(t, routes, "GET", "/targets/gateway/descriptors/"+record.Digest, "")
+	if w.Code != 200 || !bytes.Equal(w.Body.Bytes(), record.Bytes) || w.Header().Get("ETag") != `"`+record.Digest+`"` {
+		t.Fatal("descriptor bytes were rewritten")
+	}
+	tamper.Store(true)
+	w = request(t, routes, "GET", "/targets/gateway/descriptors/"+record.Digest, "")
+	if w.Code != 502 {
+		t.Fatal("descriptor whose exact bytes changed passed digest approval")
+	}
+	tamper.Store(false)
+	selection := pluginruntime.Selection{Name: "files", PluginID: d.PluginID, DescriptorDigest: record.Digest, ImplementationID: "fixture", Public: json.RawMessage(`{}`)}
+	b, _ := json.Marshal(management.ReplaceRequest{Expected: version, Selection: selection})
+	w = request(t, routes, "POST", "/targets/gateway/clients/files", string(b))
+	if w.Code != 200 || replacement.Load() != 1 {
+		t.Fatal("replacement failed", w.Code, w.Body)
+	}
+	stale := version
+	stale.Generation = 77
+	b, _ = json.Marshal(management.ReplaceRequest{Expected: stale, Selection: selection})
+	w = request(t, routes, "POST", "/targets/gateway/clients/files", string(b))
+	if w.Code != 409 || replacement.Load() != 1 || strings.Contains(w.Body.String(), "never-return-this") {
+		t.Fatal("CAS conflict lost or body exposed")
+	}
+}
