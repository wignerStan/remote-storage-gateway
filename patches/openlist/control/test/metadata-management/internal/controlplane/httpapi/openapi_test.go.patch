+func TestGeneratedManagementOpenAPIMatchesTypedRoutes(t *testing.T) {
+	registry, e := cp.New(cp.Config{Targets: []cp.Target{{Name: "offline", Kind: "rclone", Endpoint: "http://127.0.0.1:1"}}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	engine := fixtureAPI(registry)
+	response := request(t, engine, "GET", "/openapi.json", "")
+	if response.Code != 200 {
+		t.Fatal("OpenAPI unavailable", response.Code)
+	}
+	document := bytes.TrimSpace(response.Body.Bytes())
+	var spec struct {
+		OpenAPI    string                                `json:"openapi"`
+		Paths      map[string]map[string]json.RawMessage `json:"paths"`
+		Components struct {
+			Schemas map[string]json.RawMessage `json:"schemas"`
+		} `json:"components"`
+	}
+	if e = json.Unmarshal(document, &spec); e != nil {
+		t.Fatal(e)
+	}
+	if spec.OpenAPI != "3.1.0" || len(spec.Paths) != 11 {
+		t.Fatalf("generated API incomplete: version=%s paths=%d", spec.OpenAPI, len(spec.Paths))
+	}
+	expected := map[string]string{"/targets": "get", "/targets/{target}/manifest": "get", "/targets/{target}/observed": "get", "/targets/{target}/clients/{name}": "post", "/targets/{target}/descriptors/{digest}": "get", "/targets/{target}/version": "get", "/targets/{target}/stats": "get", "/targets/{target}/jobs": "get", "/targets/{target}/jobs/{id}": "get", "/targets/{target}/jobs/{id}/stop": "post", "/targets/{target}/probe": "get"}
+	for path, method := range expected {
+		if len(spec.Paths[path][method]) == 0 {
+			t.Fatal("operation missing from generated contract", method, path)
+		}
+	}
+	body := spec.Components.Schemas["StopRequest"]
+	if !bytes.Contains(body, []byte(`"execute_id"`)) || !bytes.Contains(body, []byte(`"minLength":1`)) || !bytes.Contains(body, []byte(`"maxLength":128`)) {
+		t.Fatalf("typed request constraints absent: %s", body)
+	}
+	response = request(t, engine, "GET", "/openapi.json", "")
+	if response.Code != 200 || !bytes.Equal(bytes.TrimSpace(response.Body.Bytes()), document) {
+		t.Fatal("served OpenAPI differs from registered typed contract", response.Code)
+	}
+	engine2 := fixtureAPI(registry)
+	second := bytes.TrimSpace(request(t, engine2, "GET", "/openapi.json", "").Body.Bytes())
+	if !bytes.Equal(document, second) {
+		t.Fatal("identical typed registration generated nondeterministic OpenAPI")
+	}
+}
