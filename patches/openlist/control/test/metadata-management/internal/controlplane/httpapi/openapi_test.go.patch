+func TestTypedManagementValidationPreservesStatusAndRedaction(t *testing.T) {
+	registry, e := cp.New(cp.Config{Targets: []cp.Target{{Name: "offline", Kind: "rclone", Endpoint: "http://127.0.0.1:1"}}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	engine := router(registry)
+	for _, body := range []string{`{"execute_id":""}`, `{"execute_id":"first","execute_id":"second"}`, `{"execute_id":"valid","password":"never-return-this"}`, `{"execute_id":"` + strings.Repeat("x", 129) + `"}`, strings.Repeat(" ", cp.MaxMetadata) + `{}`} {
+		response := request(t, engine, "POST", "/targets/offline/jobs/7/stop", body)
+		if response.Code != http.StatusBadRequest || strings.Contains(response.Body.String(), "never-return-this") || !strings.HasPrefix(response.Header().Get("Content-Type"), "application/json") {
+			t.Fatalf("validation changed status/envelope or echoed invalid values: %d %s", response.Code, response.Body)
+		}
+		var payload struct {
+			Code int `json:"code"`
+			Data any `json:"data"`
+		}
+		if json.Unmarshal(response.Body.Bytes(), &payload) != nil || payload.Code != 400 || payload.Data != nil {
+			t.Fatal("validation envelope changed", response.Body)
+		}
+	}
+	q := httptest.NewRequest("POST", "/api/admin/control/targets/offline/jobs/7/stop", strings.NewReader(`{"execute_id":"first","execute_id":"second"}`))
+	q.Header.Set("Content-Type", "application/json; charset=utf-8")
+	utf8Response := httptest.NewRecorder()
+	engine.ServeHTTP(utf8Response, q)
+	if utf8Response.Code != 400 {
+		t.Fatal("JSON media parameters bypassed duplicate-key rejection", utf8Response.Code)
+	}
+	response := request(t, engine, "GET", "/targets/offline/jobs/0", "")
+	if response.Code != 400 {
+		t.Fatal("typed path minimum was not enforced", response.Code)
+	}
+}
