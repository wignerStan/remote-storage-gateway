+func TestNamedManagementEntryUnavailablePreservesSanitizedEnvelope(t *testing.T) {
+	entry := httpapi.NewEntry(nil, io.EOF)
+	table, err := schemaapi.Compose(httpapi.APIConfig(), entry.RegisterRoutes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	engine, err := openapigin.New(table, openapigin.Options{Prefix: "/api/admin/control", OpenAPIPath: "/openapi", SchemasPath: "/schemas", Errors: httpapi.ErrorPolicy()})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	for _, path := range []string{"/targets", "/targets/offline/manifest", "/targets/offline/version", "/targets/offline/probe", "/targets/offline/descriptors/digest"} {
+		response := request(t, engine, "GET", path, "")
+		var payload httpapi.APIError
+		if response.Code != 503 || json.Unmarshal(response.Body.Bytes(), &payload) != nil || payload.Code != 503 || payload.Message != http.StatusText(503) || payload.Data != nil {
+			t.Fatal("unavailable entry changed status or exposed cause", path, response.Code, response.Body)
+		}
+	}
+}
