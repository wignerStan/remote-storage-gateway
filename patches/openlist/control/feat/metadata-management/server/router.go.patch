+func registerControlRoutes(g *gin.RouterGroup) {
+	management, managementErr := controlplane.Load(conf.Conf.ControlTargetsFile)
+	controlGroup := g.Group("/control")
+	entry := httpapi.NewEntry(management, managementErr)
+	table, err := schemaapi.Compose(httpapi.APIConfig(), entry.RegisterRoutes, gatewayentry.NewEntry(GatewayControl).RegisterRoutes)
+	if err != nil {
+		panic(err)
+	}
+	engine, err := openapigin.New(table, openapigin.Options{Prefix: controlGroup.BasePath(), OpenAPIPath: "/openapi", SchemasPath: "/schemas", Errors: httpapi.ErrorPolicy()})
+	if err != nil {
+		panic(err)
+	}
+	// Publish the complete validated engine through the existing administrator
+	// group so both operations and generated metadata inherit its authorization.
+	handler := gin.WrapH(engine)
+	for _, route := range engine.Routes() {
+		controlGroup.Handle(route.Method, strings.TrimPrefix(route.Path, controlGroup.BasePath()), handler)
+	}
