+package clientplugin
+
+import (
+	"io"
+	"net/http"
+)
+
+// PROPFIND is metadata. Bound the legacy XML parser without limiting streamed GETs.
+type metadataTransport struct{ base http.RoundTripper }
+
+func (t metadataTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	resp, e := t.base.RoundTrip(r)
+	if e == nil && r.Method == "PROPFIND" {
+		resp.Body = &metadataBody{ReadCloser: resp.Body, reader: io.LimitReader(resp.Body, 4<<20)}
+	}
+	return resp, e
+}
+
+type metadataBody struct {
+	io.ReadCloser
+	reader io.Reader
+}
+
+func (b *metadataBody) Read(p []byte) (int, error) { return b.reader.Read(p) }
