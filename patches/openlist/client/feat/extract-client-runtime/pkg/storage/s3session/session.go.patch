+// Package s3session shares the initializer extracted from drivers/s3.
+package s3session
+
+import (
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/credentials"
+	"github.com/aws/aws-sdk-go/aws/session"
+	"net/http"
+)
+
+type Config struct {
+	Endpoint, Region, AccessKeyID, SecretAccessKey, SessionToken string
+	ForcePathStyle                                               bool
+	HTTPClient                                                   *http.Client
+	MaxRetries                                                   *int
+}
+
+func New(config Config) (*session.Session, error) {
+	cfg := &aws.Config{
+		Credentials: credentials.NewStaticCredentials(config.AccessKeyID, config.SecretAccessKey, config.SessionToken),
+		Region:      &config.Region, Endpoint: &config.Endpoint,
+		S3ForcePathStyle: aws.Bool(config.ForcePathStyle),
+		HTTPClient:       config.HTTPClient, MaxRetries: config.MaxRetries,
+	}
+	return session.NewSession(cfg)
+}
