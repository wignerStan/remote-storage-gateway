+// WithContext creates request-local authentication and cancellation state.
+// It shares the thread-safe HTTP transport, not a mutable context on a live client.
+func (c *Client) WithContext(ctx context.Context) *Client {
+	c.authMutex.Lock()
+	user, pass := c.auth.User(), c.auth.Pass()
+	c.authMutex.Unlock()
+	return &Client{root: c.root, headers: c.headers.Clone(), interceptor: c.interceptor, c: c.c, ctx: ctx, auth: &NoAuth{user, pass}}
+}
