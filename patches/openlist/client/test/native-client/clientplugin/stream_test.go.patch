+package clientplugin
+
+import (
+	"io"
+	"strings"
+	"testing"
+)
+
+func TestKnownSizeReaderRejectsMismatch(t *testing.T) {
+	for _, n := range []int64{2, 4} {
+		if _, e := io.ReadAll(checkedBody(strings.NewReader("abc"), n)); e == nil {
+			t.Fatalf("accepted wrong size%d", n)
+		}
+	}
+	b, e := io.ReadAll(checkedBody(strings.NewReader("abc"), 3))
+	if e != nil || string(b) != "abc" {
+		t.Fatal(e)
+	}
+}
