+package main
+
+import (
+	"github.com/OpenListTeam/OpenList/v4/pluginentry"
+	"github.com/wignerStan/network-data-plane-worker/go/nativeclient/provider"
+)
+
+var buildDigest string
+
+func init() {
+	factory, err := pluginentry.NewFactory(buildDigest)
+	if err != nil {
+		// Leave the bridge unregistered: the host must reject this artifact,
+		// rather than aborting its process during dynamic library initialization.
+		return
+	}
+	provider.RegisterFactory(factory)
+}
+func main() {}
