+package clientplugin_test
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+
+	infraexec "github.com/wignerStan/infra/go/process/exec"
+	native "github.com/wignerStan/infra/go/runtime/nativeplugin"
+	port "github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/client"
+	"github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/descriptor/admission"
+	"github.com/wignerStan/network-data-plane-worker/go/nativeclient"
+	"golang.org/x/net/webdav"
+)
+
+func TestSeparateSharedLibraryClientLifecycle(t *testing.T) {
+	_, source, _, _ := runtime.Caller(0)
+	root := filepath.Dir(filepath.Dir(source))
+	so := filepath.Join(t.TempDir(), "openlist-client.so")
+	digest := "sha256:" + strings.Repeat("1", 64)
+	spec := infraexec.NewSpec(filepath.Join(runtime.GOROOT(), "bin", "go"), "build", "-buildmode=c-shared", "-buildvcs=false", "-ldflags", "-X main.buildDigest="+digest, "-o", so, "./cmd/openlist-client-plugin").WithTimeout(3 * time.Minute).WithEnv(infraexec.EnvInheritAllButRedacted())
+	spec.Dir = root
+	out, e := infraexec.RunContext(context.Background(), spec)
+	if e != nil {
+		t.Fatalf("build separate plugin: %v %s%s", e, out.StdoutString(), out.StderrString())
+	}
+	raw, e := native.Load(so, native.Expected{Package: "client.openlist", Variant: nativeclient.Variant, Kind: native.Tool, Language: native.Go, UnloadPolicy: native.Retain}, native.Limits{MaxInput: 1 << 20, MaxReply: 1 << 20, MaxInflight: 16, Timeout: 10 * time.Second})
+	if e != nil {
+		t.Fatal(e)
+	}
+	b, e := raw.Call(context.Background(), nativeclient.Describe, []byte(`{}`))
+	if e != nil {
+		t.Fatal(e)
+	}
+	r, e := admission.Decode(b)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = raw.Close(context.Background()); e != nil {
+		t.Fatal(e)
+	}
+	data, e := os.ReadFile(so)
+	if e != nil {
+		t.Fatal(e)
+	}
+	hash := sha256.Sum256(data)
+	factory, e := nativeclient.NewFactory(context.Background(), nativeclient.Artifact{Path: so, SHA256: hex.EncodeToString(hash[:]), DescriptorDigest: r.Digest, PluginID: "client.openlist", Language: "go"})
+	if e != nil {
+		t.Fatal(e)
+	}
+	dir := t.TempDir()
+	dav := &webdav.Handler{FileSystem: webdav.Dir(dir), LockSystem: webdav.NewMemLS()}
+	if e = os.WriteFile(filepath.Join(dir, "blocked"), []byte("pending read"), 0600); e != nil {
+		t.Fatal(e)
+	}
+	upstreamCancelled := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodGet && r.URL.Path == "/blocked" {
+			w.Header().Set("Content-Length", "12")
+			w.Header().Set("Content-Range", "bytes 0-11/12")
+			w.WriteHeader(http.StatusPartialContent)
+			w.(http.Flusher).Flush()
+			<-r.Context().Done()
+			close(upstreamCancelled)
+			return
+		}
+		dav.ServeHTTP(w, r)
+	}))
+	defer server.Close()
+	config, _ := json.Marshal(map[string]string{"address": server.URL})
+	candidate, e := factory.Prepare(context.Background(), port.PluginConfig{ImplementationID: "webdav", Public: config})
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = candidate.Validate(context.Background()); e != nil {
+		t.Fatal(e)
+	}
+	client, e := candidate.Publish()
+	if e != nil {
+		t.Fatal(e)
+	}
+	if _, e = client.Put(context.Background(), port.PutRequest{Path: "/native.txt", Body: strings.NewReader("native shared library"), Size: -1}); e != nil {
+		t.Fatal(e)
+	}
+	plan, e := client.Open(context.Background(), port.OpenRequest{Path: "/native.txt", Offset: 7, Length: 6})
+	if e != nil {
+		t.Fatal(e)
+	}
+	body, e := io.ReadAll(plan.Body)
+	plan.Body.Close()
+	if e != nil || string(body) != "shared" {
+		t.Fatalf("native range=%q error=%v", body, e)
+	}
+	blocked, e := client.Open(context.Background(), port.OpenRequest{Path: "/blocked", Length: -1})
+	if e != nil {
+		t.Fatal(e)
+	}
+	readDone := make(chan error, 1)
+	go func() { var b [1]byte; _, err := blocked.Body.Read(b[:]); readDone <- err }()
+	if e = blocked.Body.Close(); e != nil {
+		t.Fatal(e)
+	}
+	select {
+	case err := <-readDone:
+		if err == nil {
+			t.Fatal("cancelled read succeeded")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("native pending read did not join")
+	}
+	select {
+	case <-upstreamCancelled:
+	case <-time.After(5 * time.Second):
+		t.Fatal("native reader close did not cancel provider HTTP request")
+	}
+	if e = client.Close(context.Background()); e != nil {
+		t.Fatal(e)
+	}
+	if _, e = client.Stat(context.Background(), port.ObjectRef{Path: "/native.txt"}); e == nil {
+		t.Fatal("closed native client accepted request")
+	}
+}
diff --git a/clientplugin/s3.go b/clientplugin/s3.go
new file mode 100644
index 0000000000000000000000000000000000000000..b59f54f51a522d5138b56716e2c3eb40f985f2f4
--- /dev/null
+++ b/clientplugin/s3.go
@@ -0,0 +1,195 @@
+package clientplugin
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"path"
+	"strings"
+	"time"
+
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/awserr"
+	"github.com/aws/aws-sdk-go/aws/credentials"
+	"github.com/aws/aws-sdk-go/aws/session"
+	"github.com/aws/aws-sdk-go/service/s3"
+	"github.com/aws/aws-sdk-go/service/s3/s3manager"
+	port "github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/client"
+)
+
+type s3Client struct {
+	api          *s3.S3
+	session      *session.Session
+	bucket, root string
+	transport    *http.Transport
+}
+
+func newS3(c s3Config, access, key, token string) (*s3Client, error) {
+	t := http.DefaultTransport.(*http.Transport).Clone()
+	cfg := aws.NewConfig().WithRegion(c.Region).WithEndpoint(c.Endpoint).WithS3ForcePathStyle(c.ForcePathStyle).WithCredentials(credentials.NewStaticCredentials(access, key, token)).WithHTTPClient(&http.Client{Transport: t}).WithMaxRetries(0)
+	s, e := session.NewSession(cfg)
+	if e != nil {
+		return nil, port.ErrInvalid
+	}
+	root, _ := clean(c.Root)
+	return &s3Client{s3.New(s), s, c.Bucket, root, t}, nil
+}
+func (d *s3Client) key(p string) (string, error) {
+	p, e := clean(p)
+	if e != nil {
+		return "", e
+	}
+	k := path.Join(d.root, p)
+	if k == "." {
+		k = ""
+	}
+	return k, nil
+}
+func (d *s3Client) validate(ctx context.Context) error {
+	_, e := d.api.HeadBucketWithContext(ctx, &s3.HeadBucketInput{Bucket: &d.bucket})
+	return s3Error(ctx, e)
+}
+func (d *s3Client) public(k string) string {
+	if d.root != "" {
+		k = strings.TrimPrefix(k, d.root+"/")
+	}
+	return objectPath(k)
+}
+func s3Error(ctx context.Context, e error) error {
+	if e == nil {
+		return nil
+	}
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	if a, ok := e.(awserr.RequestFailure); ok && a.StatusCode() == http.StatusNotFound {
+		return port.ErrNotFound
+	}
+	return providerError(e)
+}
+func (d *s3Client) Stat(ctx context.Context, q port.ObjectRef) (port.ObjectInfo, error) {
+	k, e := d.key(q.Path)
+	if e != nil {
+		return port.ObjectInfo{}, e
+	}
+	if k == "" || k == d.root && strings.Trim(q.Path, "/") == "" {
+		return port.ObjectInfo{Path: "/", IsDir: true}, nil
+	}
+	o, e := d.api.HeadObjectWithContext(ctx, &s3.HeadObjectInput{Bucket: &d.bucket, Key: &k})
+	if e != nil {
+		if s3Error(ctx, e) == port.ErrNotFound {
+			prefix := strings.TrimSuffix(k, "/") + "/"
+			listed, err := d.api.ListObjectsV2WithContext(ctx, &s3.ListObjectsV2Input{Bucket: &d.bucket, Prefix: &prefix, MaxKeys: aws.Int64(1)})
+			if err == nil && len(listed.Contents) > 0 {
+				return port.ObjectInfo{Path: objectPath(q.Path), IsDir: true}, nil
+			}
+			if err != nil {
+				return port.ObjectInfo{}, s3Error(ctx, err)
+			}
+		}
+		return port.ObjectInfo{}, s3Error(ctx, e)
+	}
+	return port.ObjectInfo{Path: objectPath(q.Path), Size: aws.Int64Value(o.ContentLength), ModTime: aws.TimeValue(o.LastModified), ETag: aws.StringValue(o.ETag), ContentType: aws.StringValue(o.ContentType)}, nil
+}
+func (d *s3Client) List(ctx context.Context, q port.ListRequest) (port.ListResult, error) {
+	if q.Limit < 0 || q.Limit > 1000 {
+		return port.ListResult{}, port.ErrInvalid
+	}
+	k, e := d.key(q.Path)
+	if e != nil {
+		return port.ListResult{}, e
+	}
+	if k != "" {
+		k += "/"
+	}
+	n := q.Limit
+	if n == 0 {
+		n = 1000
+	}
+	in := &s3.ListObjectsV2Input{Bucket: &d.bucket, Prefix: &k, Delimiter: aws.String("/"), MaxKeys: aws.Int64(int64(n))}
+	if q.Cursor != "" {
+		in.ContinuationToken = &q.Cursor
+	}
+	v, e := d.api.ListObjectsV2WithContext(ctx, in)
+	if e != nil {
+		return port.ListResult{}, s3Error(ctx, e)
+	}
+	out := port.ListResult{Objects: []port.ObjectInfo{}, NextCursor: aws.StringValue(v.NextContinuationToken)}
+	for _, x := range v.CommonPrefixes {
+		out.Objects = append(out.Objects, port.ObjectInfo{Path: d.public(strings.TrimSuffix(aws.StringValue(x.Prefix), "/")), IsDir: true})
+	}
+	for _, x := range v.Contents {
+		key := aws.StringValue(x.Key)
+		if key == k {
+			continue
+		}
+		out.Objects = append(out.Objects, port.ObjectInfo{Path: d.public(key), Size: aws.Int64Value(x.Size), ModTime: aws.TimeValue(x.LastModified), ETag: aws.StringValue(x.ETag)})
+	}
+	return out, nil
+}
+func (d *s3Client) Open(ctx context.Context, q port.OpenRequest) (port.ReadPlan, error) {
+	info, e := d.Stat(ctx, port.ObjectRef{Path: q.Path})
+	if e != nil {
+		return port.ReadPlan{}, e
+	}
+	n, e := checkedRange(q, info.Size)
+	if e != nil || info.IsDir {
+		return port.ReadPlan{}, port.ErrInvalid
+	}
+	if n == 0 {
+		return port.ReadPlan{Info: info, Body: io.NopCloser(strings.NewReader(""))}, nil
+	}
+	k, _ := d.key(q.Path)
+	in := &s3.GetObjectInput{Bucket: &d.bucket, Key: &k, Range: aws.String(fmt.Sprintf("bytes=%d-%d", q.Offset, q.Offset+n-1))}
+	o, e := d.api.GetObjectWithContext(ctx, in)
+	if e != nil {
+		return port.ReadPlan{}, s3Error(ctx, e)
+	}
+	if aws.Int64Value(o.ContentLength) != n || ((q.Offset != 0 || n != info.Size) && aws.StringValue(o.ContentRange) != fmt.Sprintf("bytes %d-%d/%d", q.Offset, q.Offset+n-1, info.Size)) {
+		if o.Body != nil {
+			o.Body.Close()
+		}
+		return port.ReadPlan{}, port.ErrProvider
+	}
+	return port.ReadPlan{Info: info, Body: o.Body}, nil
+}
+func (d *s3Client) Put(ctx context.Context, q port.PutRequest) (port.PutResult, error) {
+	if q.Body == nil || q.Size < -1 || len(q.Metadata) > 0 {
+		return port.PutResult{}, port.ErrInvalid
+	}
+	k, e := d.key(q.Path)
+	if e != nil || strings.Trim(q.Path, "/") == "" {
+		return port.PutResult{}, port.ErrInvalid
+	}
+	meta := map[string]*string{}
+	for key, value := range q.Metadata {
+		v := value
+		meta[key] = &v
+	}
+	body := &uploadReader{reader: checkedBody(q.Body, q.Size)}
+	u := s3manager.NewUploader(d.session, func(u *s3manager.Uploader) { u.Concurrency = 1; u.PartSize = 5 << 20 })
+	_, e = u.UploadWithContext(ctx, &s3manager.UploadInput{Bucket: &d.bucket, Key: &k, Body: body, ContentType: aws.String(q.ContentType), Metadata: meta})
+	if e != nil {
+		return port.PutResult{}, s3Error(ctx, e)
+	}
+	return port.PutResult{Info: port.ObjectInfo{Path: objectPath(q.Path), Size: body.bytes.Load(), ModTime: time.Now().UTC(), ContentType: q.ContentType}}, nil
+}
+func (d *s3Client) Delete(ctx context.Context, q port.ObjectRef) error {
+	k, e := d.key(q.Path)
+	if e != nil || strings.Trim(q.Path, "/") == "" {
+		return port.ErrInvalid
+	}
+	info, err := d.Stat(ctx, q)
+	if err != nil {
+		return err
+	}
+	if info.IsDir {
+		return port.ErrUnsupported
+	}
+	_, e = d.api.DeleteObjectWithContext(ctx, &s3.DeleteObjectInput{Bucket: &d.bucket, Key: &k})
+	return s3Error(ctx, e)
+}
+func (d *s3Client) Close(context.Context) error { closeTransport(d.transport); return nil }
+
+var _ port.Client = (*s3Client)(nil)
