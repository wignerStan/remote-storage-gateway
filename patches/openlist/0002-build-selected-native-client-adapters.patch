+package clientplugin
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	port "github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/client"
+)
+
+func TestS3PrefixRangeAndImplicitDirectory(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if !strings.HasPrefix(r.Header.Get("Authorization"), "AWS4-HMAC-SHA256 ") {
+			t.Error("request was not signed")
+		}
+		switch {
+		case r.Method == "HEAD" && r.URL.Path == "/bucket":
+			w.WriteHeader(200)
+		case r.Method == "HEAD" && r.URL.Path == "/bucket/prefix/item":
+			w.Header().Set("Content-Length", "6")
+			w.Header().Set("Etag", `"test"`)
+			w.WriteHeader(200)
+		case r.Method == "GET" && r.URL.Path == "/bucket/prefix/item":
+			if r.Header.Get("Range") != "bytes=1-3" {
+				t.Errorf("range=%s", r.Header.Get("Range"))
+			}
+			w.Header().Set("Content-Range", "bytes 1-3/6")
+			w.Header().Set("Content-Length", "3")
+			w.WriteHeader(206)
+			io.WriteString(w, "bcd")
+		case r.Method == "HEAD" && r.URL.Path == "/bucket/prefix/dir":
+			w.WriteHeader(404)
+		case r.Method == "GET" && r.URL.Path == "/bucket":
+			if r.URL.Query().Get("prefix") != "prefix/dir/" {
+				t.Error("prefix escaped scope")
+			}
+			io.WriteString(w, `<ListBucketResult><Contents><Key>prefix/dir/child</Key><Size>1</Size></Contents></ListBucketResult>`)
+		default:
+			t.Errorf("unexpected %s %s", r.Method, r.URL.Path)
+			w.WriteHeader(500)
+		}
+	}))
+	defer server.Close()
+	c, e := newS3(s3Config{Endpoint: server.URL, Bucket: "bucket", Region: "us-east-1", Root: "prefix", ForcePathStyle: true}, "test-access", "test-secret", "")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer c.Close(context.Background())
+	if e = c.validate(context.Background()); e != nil {
+		t.Fatal(e)
+	}
+	plan, e := c.Open(context.Background(), port.OpenRequest{Path: "/item", Offset: 1, Length: 3})
+	if e != nil {
+		t.Fatal(e)
+	}
+	b, e := io.ReadAll(plan.Body)
+	plan.Body.Close()
+	if e != nil || string(b) != "bcd" {
+		t.Fatal(string(b), e)
+	}
+	info, e := c.Stat(context.Background(), port.ObjectRef{Path: "/dir"})
+	if e != nil || !info.IsDir {
+		t.Fatalf("directory %+v %v", info, e)
+	}
+	if k, _ := c.key("/.kopiaignore"); k != "prefix/.kopiaignore" {
+		t.Fatal("hidden object name changed", k)
+	}
+	if e = c.Delete(context.Background(), port.ObjectRef{Path: "/dir"}); e != port.ErrUnsupported {
+		t.Fatal("directory delete silently succeeded", e)
+	}
+}
diff --git a/clientplugin/stream.go b/clientplugin/stream.go
new file mode 100644
index 0000000000000000000000000000000000000000..ae6b918f98276620eab50129b240f1d814c6a36c
--- /dev/null
+++ b/clientplugin/stream.go
@@ -0,0 +1,66 @@
+package clientplugin
+
+import (
+	"errors"
+	"io"
+	"sync/atomic"
+
+	port "github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/client"
+)
+
+// A mismatch terminates the upload reader before a multipart completion request.
+// No request body is cached or replayed to repair a mismatch.
+type sizedReader struct {
+	body      io.Reader
+	remaining int64
+	ended     bool
+}
+
+func checkedBody(body io.Reader, size int64) io.Reader {
+	if size < 0 {
+		return body
+	}
+	return &sizedReader{body: body, remaining: size}
+}
+func (r *sizedReader) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	if r.ended {
+		return 0, io.EOF
+	}
+	if r.remaining == 0 {
+		var b [1]byte
+		n, e := r.body.Read(b[:])
+		if n > 0 {
+			return 0, port.ErrInvalid
+		}
+		if e == io.EOF {
+			r.ended = true
+		}
+		return 0, e
+	}
+	if int64(len(p)) > r.remaining {
+		p = p[:r.remaining]
+	}
+	n, e := r.body.Read(p)
+	r.remaining -= int64(n)
+	if errors.Is(e, io.EOF) {
+		if r.remaining != 0 {
+			return n, io.ErrUnexpectedEOF
+		}
+		r.ended = true
+	}
+	return n, e
+}
+
+type uploadReader struct {
+	reader io.Reader
+	bytes  atomic.Int64
+}
+
+func (r *uploadReader) Read(p []byte) (int, error) {
+	n, e := r.reader.Read(p)
+	r.bytes.Add(int64(n))
+	return n, e
+}
