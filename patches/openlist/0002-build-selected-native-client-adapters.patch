+++ b/clientplugin/configuration_test.go
@@ -0,0 +1,77 @@
+package clientplugin
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/wignerStan/infra/go/code/schema"
+	"github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/descriptor"
+	"github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/descriptor/admission"
+)
+
+func TestOwnedConfigurationSchemasGenerateStandardSecretSemantics(t *testing.T) {
+	first, e := ConfigurationSchemas()
+	if e != nil {
+		t.Fatal(e)
+	}
+	second, e := ConfigurationSchemas()
+	if e != nil {
+		t.Fatal(e)
+	}
+	a, _ := json.Marshal(first)
+	b, _ := json.Marshal(second)
+	if !bytes.Equal(a, b) || first.S3.ID == first.WebDAV.ID || first.S3.Owner != PluginID {
+		t.Fatal("owned schema identity/generation is unstable")
+	}
+	for _, doc := range []schema.Document{first.S3, first.WebDAV} {
+		if doc.Kind != "json-schema" || doc.Version != "1" || doc.Schema == nil {
+			t.Fatal("structured schema identity missing")
+		}
+		switch doc.Schema.(type) {
+		case string, []byte, json.RawMessage:
+			t.Fatal("owned generation returned formatted bytes instead of structured schema")
+		}
+	}
+	published := NewFactory("sha256:" + string(bytes.Repeat([]byte("1"), 64))).Descriptor()
+	if published.Schema != "network-data-plane-worker/plugin-descriptor/v2" {
+		t.Fatal("breaking schema shape was published under old descriptor version")
+	}
+	var s3, dav descriptor.Implementation
+	for _, impl := range published.Implementations {
+		switch impl.ID {
+		case "s3":
+			s3 = impl
+		case "webdav":
+			dav = impl
+		}
+	}
+	fields := admission.SecretFields(s3)
+	required := map[string]bool{}
+	for _, field := range fields {
+		required[field.Name] = field.Required
+	}
+	if len(fields) != 3 || !required["access_key_id"] || !required["secret_access_key"] || required["session_token"] {
+		t.Fatal("S3 required/optional credential semantics changed")
+	}
+	davSecrets := admission.SecretFields(dav)
+	if len(davSecrets) != 1 || davSecrets[0].Name != "password" || davSecrets[0].Required {
+		t.Fatal("optional WebDAV credential semantics changed")
+	}
+	valid := json.RawMessage(`{"endpoint":"https://example.test","bucket":"selected","region":"us-east-1"}`)
+	refs := map[string]string{"access_key_id": "access-ref", "secret_access_key": "key-ref"}
+	if admission.ValidateConfig(s3, valid, refs) != nil {
+		t.Fatal("valid public/reference separation rejected")
+	}
+	for _, input := range []json.RawMessage{json.RawMessage(`{"endpoint":"https://example.test","bucket":"selected","region":"us-east-1","secret_access_key":"inline"}`), json.RawMessage(`{"endpoint":"https://example.test","bucket":"selected","region":"us-east-1","undeclared":true}`), json.RawMessage(`{"endpoint":"https://example.test","bucket":"selected"}`)} {
+		if admission.ValidateConfig(s3, input, refs) == nil {
+			t.Fatal("public secret/unknown/missing required input admitted")
+		}
+	}
+	if admission.ValidateConfig(s3, valid, nil) == nil {
+		t.Fatal("required secret references were lost")
+	}
+	if admission.ValidateConfig(dav, json.RawMessage(`{"address":"https://example.test"}`), nil) != nil {
+		t.Fatal("optional WebDAV fields became required")
+	}
+}
diff --git a/clientplugin/factory.go b/clientplugin/factory.go
new file mode 100644
index 0000000000000000000000000000000000000000..e16fc473accf5e73efafdfae6e1505b6e21dc203
--- /dev/null
+++ b/clientplugin/factory.go
@@ -0,0 +1,198 @@
+// Package clientplugin publishes OpenList-derived providers against the Worker contract.
+package clientplugin
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/url"
+	"path"
+	"strings"
+	"sync"
+
+	port "github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/client"
+	"github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/descriptor"
+	"github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/descriptor/admission"
+)
+
+const PluginID = "client.openlist"
+const Version = "0.1.0-alpha.2"
+
+type Factory struct{ build string }
+
+func NewFactory(buildDigest string) *Factory { return &Factory{build: buildDigest} }
+func (f *Factory) Descriptor() descriptor.Descriptor {
+	schemas, e := ConfigurationSchemas()
+	if e != nil {
+		return descriptor.Descriptor{}
+	}
+	return descriptor.Descriptor{Schema: descriptor.Schema, PluginID: PluginID, PluginVersion: Version, Contract: port.Contract, Runtime: "go", BuildDigest: f.build, Implementations: []descriptor.Implementation{
+		{ID: "s3", DisplayName: "OpenList S3", ConfigSchema: encodeConfigurationSchema(schemas.S3), Capabilities: []string{"stat", "list", "open", "put", "delete", "range", "unknown-size-put", "list-pagination"}},
+		{ID: "webdav", DisplayName: "OpenList WebDAV", ConfigSchema: encodeConfigurationSchema(schemas.WebDAV), Capabilities: []string{"stat", "list", "open", "put", "delete", "range", "unknown-size-put"}},
+	}}
+}
+
+func endpoint(raw string) error {
+	u, e := url.Parse(raw)
+	if e != nil || u.Host == "" || (u.Scheme != "http" && u.Scheme != "https") || u.User != nil || u.RawQuery != "" || u.Fragment != "" {
+		return port.ErrInvalid
+	}
+	return nil
+}
+func secret(ctx context.Context, r port.SecretResolver, name string, required bool) (string, error) {
+	if r == nil {
+		if required {
+			return "", port.ErrInvalid
+		}
+		return "", nil
+	}
+	s, e := r.Resolve(ctx, name)
+	if e != nil {
+		if required || !errors.Is(e, port.ErrNotFound) {
+			return "", port.ErrInvalid
+		}
+		return "", nil
+	}
+	if s == nil {
+		return "", port.ErrInvalid
+	}
+	defer s.Close()
+	b := s.Bytes()
+	if len(b) > 65536 || required && len(b) == 0 {
+		return "", port.ErrInvalid
+	}
+	return string(b), nil
+}
+func (f *Factory) Prepare(ctx context.Context, c port.PluginConfig) (port.Candidate, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := admission.Validate(f.Descriptor()); err != nil {
+		return nil, port.ErrInvalid
+	}
+	var cli port.Client
+	var err error
+	switch c.ImplementationID {
+	case "s3":
+		var cfg s3Config
+		if admission.StrictJSON(c.Public, &cfg) != nil || endpoint(cfg.Endpoint) != nil || cfg.Bucket == "" || cfg.Region == "" {
+			return nil, port.ErrInvalid
+		}
+		if _, err = clean(cfg.Root); err != nil {
+			return nil, err
+		}
+		var access, key, token string
+		access, err = secret(ctx, c.Secrets, "access_key_id", true)
+		if err != nil {
+			return nil, err
+		}
+		key, err = secret(ctx, c.Secrets, "secret_access_key", true)
+		if err != nil {
+			return nil, err
+		}
+		token, err = secret(ctx, c.Secrets, "session_token", false)
+		if err != nil {
+			return nil, err
+		}
+		cli, err = newS3(cfg, access, key, token)
+	case "webdav":
+		var cfg davConfig
+		if admission.StrictJSON(c.Public, &cfg) != nil || endpoint(cfg.Address) != nil {
+			return nil, port.ErrInvalid
+		}
+		if _, err = clean(cfg.Root); err != nil {
+			return nil, err
+		}
+		var password string
+		password, err = secret(ctx, c.Secrets, "password", false)
+		if err != nil {
+			return nil, err
+		}
+		cli = newWebDAV(cfg, password)
+	default:
+		return nil, port.ErrUnsupported
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &candidate{client: cli}, nil
+}
+
+type candidate struct {
+	mu                            sync.Mutex
+	client                        port.Client
+	validated, published, aborted bool
+}
+
+func (c *candidate) Validate(ctx context.Context) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.aborted || c.published {
+		return port.ErrInvalid
+	}
+	var e error
+	if v, ok := c.client.(interface{ validate(context.Context) error }); ok {
+		e = v.validate(ctx)
+	} else {
+		_, e = c.client.Stat(ctx, port.ObjectRef{Path: "/"})
+	}
+	if e == nil {
+		c.validated = true
+	}
+	return e
+}
+func (c *candidate) Publish() (port.Client, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.validated || c.published || c.aborted {
+		return nil, port.ErrInvalid
+	}
+	c.published = true
+	return c.client, nil
+}
+func (c *candidate) Abort(ctx context.Context) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.aborted {
+		return nil
+	}
+	if c.published {
+		return port.ErrInvalid
+	}
+	c.aborted = true
+	return c.client.Close(ctx)
+}
+func clean(p string) (string, error) {
+	if strings.ContainsAny(p, "\\\x00") {
+		return "", port.ErrInvalid
+	}
+	for _, x := range strings.Split(p, "/") {
+		if x == ".." || x == "." {
+			return "", port.ErrInvalid
+		}
+	}
+	return strings.Trim(path.Clean("/"+p), "/"), nil
+}
+func objectPath(p string) string { return "/" + strings.TrimPrefix(p, "/") }
+func checkedRange(q port.OpenRequest, size int64) (int64, error) {
+	if q.Offset < 0 || q.Length < -1 || q.Offset > size || q.Length > 0 && q.Offset > int64(^uint64(0)>>1)-q.Length {
+		return 0, port.ErrInvalid
+	}
+	n := size - q.Offset
+	if q.Length >= 0 && q.Length < n {
+		n = q.Length
+	}
+	return n, nil
+}
+func providerError(err error) error {
+	if err == nil {
+		return nil
+	}
+	if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+		return err
+	}
+	return port.ErrProvider
+}
+func closeTransport(t *http.Transport) { t.CloseIdleConnections() }
+
+var _ port.Factory = (*Factory)(nil)
