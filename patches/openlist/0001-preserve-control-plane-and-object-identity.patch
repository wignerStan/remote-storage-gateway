+func TestManagementBoundsRedirectAndCancellation(t *testing.T) {
+	var leaked atomic.Int32
+	destination := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { leaked.Add(1); w.WriteHeader(200) }))
+	defer destination.Close()
+	redirect := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Location", destination.URL)
+		w.WriteHeader(307)
+	}))
+	defer redirect.Close()
+	registry, e := cp.New(cp.Config{Targets: []cp.Target{{Name: "rc", Kind: "rclone", Endpoint: redirect.URL, Username: "user", PasswordSecretRef: "secret"}, {Name: "dav", Kind: "origin-webdav", Endpoint: redirect.URL, Username: "user", PasswordSecretRef: "secret"}}, SecretFiles: map[string]string{"secret": secretFile(t, "password")}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	routes := router(registry)
+	for _, p := range []string{"/targets/rc/version", "/targets/dav/probe"} {
+		w := request(t, routes, "GET", p, "")
+		if w.Code != 502 {
+			t.Fatal("redirect accepted")
+		}
+	}
+	if leaked.Load() != 0 {
+		t.Fatal("credentials/request followed redirected management origin")
+	}
+	oversized := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.WriteString(w, `{"version":"`+strings.Repeat("a", cp.MaxMetadata)+`"}`)
+	}))
+	defer oversized.Close()
+	registry, e = cp.New(cp.Config{Targets: []cp.Target{{Name: "rc", Kind: "rclone", Endpoint: oversized.URL}}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	w := request(t, router(registry), "GET", "/targets/rc/version", "")
+	if w.Code != 502 {
+		t.Fatal("oversized metadata accepted")
+	}
+	cancelled := make(chan struct{})
+	blocked := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		_ = r.Body.Close()
+		<-r.Context().Done()
+		close(cancelled)
+	}))
+	defer blocked.Close()
+	registry, e = cp.New(cp.Config{Targets: []cp.Target{{Name: "rc", Kind: "rclone", Endpoint: blocked.URL}}})
+	if e != nil {
+		t.Fatal(e)
+	}
+	ctx, stop := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer stop()
+	client, _ := registry.RcloneClient("rc")
+	_, e = client.Version(ctx)
+	if e == nil {
+		t.Fatal("cancelled request succeeded")
+	}
+	select {
+	case <-cancelled:
+	case <-time.After(time.Second):
+		t.Fatal("request context did not reach management endpoint")
+	}
+}
