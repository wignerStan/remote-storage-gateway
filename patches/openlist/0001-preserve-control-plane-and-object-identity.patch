+)
+
+func secretFile(t *testing.T, value string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "secret")
+	if e := os.WriteFile(p, []byte(value), 0600); e != nil {
+		t.Fatal(e)
+	}
+	return p
+}
+func fixtureAPI(engine *gin.Engine, r *cp.Registry) {
+	entry := httpapi.NewEntry(r, nil)
+	table, err := schemaapi.Compose(httpapi.APIConfig(), entry.RegisterRoutes)
+	if err != nil {
+		panic(err)
+	}
+	if err = schemaapi.MountGin(engine, engine.Group("/api/admin/control"), table); err != nil {
+		panic(err)
+	}
+}
+func router(r *cp.Registry) http.Handler {
+	engine := gin.New()
+	fixtureAPI(engine, r)
+	return engine
+}
