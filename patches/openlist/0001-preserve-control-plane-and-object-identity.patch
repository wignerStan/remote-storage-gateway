+type APIError struct {
+	Code    int       `json:"code"`
+	Message string    `json:"message"`
+	Data    *struct{} `json:"data"`
+}
+
+func (e *APIError) Error() string  { return e.Message }
+func (e *APIError) GetStatus() int { return e.Code }
+func rejected(code int) error      { return &APIError{Code: code, Message: http.StatusText(code)} }
+func errorStatus(err error) int {
+	if errors.Is(err, controlplane.ErrInvalid) {
+		return 400
+	}
+	if errors.Is(err, controlplane.ErrConflict) {
+		return 409
+	}
+	var upstream *management.StatusError
+	if errors.As(err, &upstream) && upstream.StatusCode == 409 {
+		return 409
+	}
+	return 502
+}
+
+type Envelope[T any] struct {
+	Code    int    `json:"code"`
+	Message string `json:"message"`
+	Data    T      `json:"data"`
+}
+type Output[T any] struct{ Body Envelope[T] }
+type TargetInput struct {
+	Target string `path:"target"`
+}
+type DescriptorInput struct {
+	TargetInput
+	Digest string `path:"digest"`
+}
+type ReplaceInput struct {
+	TargetInput
+	Name string `path:"name"`
+	// Worker-owned body is forwarded unchanged; its schema and semantic validation
+	// remain authoritative in the Worker contract.
+	Body management.ReplaceRequest
+}
+type JobInput struct {
+	TargetInput
+	ID int64 `path:"id" minimum:"1"`
+}
+type StopRequest struct {
+	ExecuteID string `json:"execute_id" minLength:"1" maxLength:"128"`
+}
+type StopInput struct {
+	JobInput
+	Body StopRequest
+}
+
+// ManagementEntry is the complete administrative entry contract. Each named
+// method consumes typed input. RegisterRoutes contributes these concrete methods
+// to the schema effect tool; the host supplies the HTTP runtime binding.
+type ManagementEntry interface {
+	RegisterRoutes(api.RouteTable) error
+	Targets(context.Context, *EmptyInput) (*Output[[]controlplane.Summary], error)
+	Manifest(context.Context, *TargetInput) (*Output[worker.Manifest], error)
+	Observed(context.Context, *TargetInput) (*Output[[]worker.Observed], error)
+	Replace(context.Context, *ReplaceInput) (*Output[worker.Version], error)
+	Descriptor(context.Context, *DescriptorInput) (*api.RawJSON, error)
+	Version(context.Context, *TargetInput) (*Output[controlplane.RcloneVersion], error)
+	Stats(context.Context, *TargetInput) (*Output[controlplane.RcloneStats], error)
+	Jobs(context.Context, *TargetInput) (*Output[controlplane.RcloneJobs], error)
+	Job(context.Context, *JobInput) (*Output[controlplane.RcloneJob], error)
+	Stop(context.Context, *StopInput) (*Output[struct{}], error)
+	Probe(context.Context, *TargetInput) (*Output[controlplane.OriginStatus], error)
+}
+
+type EmptyInput struct{}
+type registryEntry struct {
+	registry *controlplane.Registry
+	loadErr  error
+}
+
+func NewEntry(registry *controlplane.Registry, loadErr error) ManagementEntry {
+	return &registryEntry{registry: registry, loadErr: loadErr}
+}
+func (e *registryEntry) ready() error {
+	if e.loadErr != nil || e.registry == nil {
+		return rejected(503)
+	}
+	return nil
+}
+func output[T any](value T, err error) (*Output[T], error) {
+	if err != nil {
+		return nil, rejected(errorStatus(err))
+	}
+	return &Output[T]{Body: Envelope[T]{Code: 200, Message: http.StatusText(200), Data: value}}, nil
+}
+func (e *registryEntry) worker(name string) (*management.Client, error) {
+	if err := e.ready(); err != nil {
+		return nil, err
+	}
+	c, err := e.registry.WorkerClient(name)
+	if err != nil {
+		return nil, rejected(404)
+	}
+	return c, nil
+}
+func (e *registryEntry) rclone(name string) (*controlplane.Rclone, error) {
+	if err := e.ready(); err != nil {
+		return nil, err
+	}
+	c, err := e.registry.RcloneClient(name)
+	if err != nil {
+		return nil, rejected(404)
+	}
+	return c, nil
+}
+func (e *registryEntry) Targets(ctx context.Context, in *EmptyInput) (*Output[[]controlplane.Summary], error) {
+	if err := e.ready(); err != nil {
+		return nil, err
+	}
+	return output(e.registry.Summaries(), nil)
+}
+func (e *registryEntry) Manifest(ctx context.Context, in *TargetInput) (*Output[worker.Manifest], error) {
+	c, err := e.worker(in.Target)
+	if err != nil {
+		return nil, err
+	}
+	return output(c.Manifest(ctx))
+}
+func (e *registryEntry) Observed(ctx context.Context, in *TargetInput) (*Output[[]worker.Observed], error) {
+	c, err := e.worker(in.Target)
+	if err != nil {
+		return nil, err
+	}
+	return output(c.Observed(ctx))
+}
+func (e *registryEntry) Replace(ctx context.Context, in *ReplaceInput) (*Output[worker.Version], error) {
+	c, err := e.worker(in.Target)
+	if err != nil {
+		return nil, err
+	}
+	if in.Body.Selection.Name != in.Name {
+		return nil, rejected(400)
+	}
+	return output(c.Replace(ctx, in.Name, in.Body.Expected, in.Body.Selection))
+}
+func (e *registryEntry) Descriptor(ctx context.Context, in *DescriptorInput) (*api.RawJSON, error) {
+	c, err := e.worker(in.Target)
+	if err != nil {
+		return nil, err
+	}
+	r, err := c.Descriptor(ctx, in.Digest)
+	if err != nil {
+		return nil, rejected(errorStatus(err))
+	}
+	return &api.RawJSON{Body: r.Bytes, ContentType: "application/json", ETag: `"` + r.Digest + `"`}, nil
+}
+func (e *registryEntry) Version(ctx context.Context, in *TargetInput) (*Output[controlplane.RcloneVersion], error) {
+	c, err := e.rclone(in.Target)
+	if err != nil {
+		return nil, err
+	}
+	return output(c.Version(ctx))
+}
+func (e *registryEntry) Stats(ctx context.Context, in *TargetInput) (*Output[controlplane.RcloneStats], error) {
+	c, err := e.rclone(in.Target)
+	if err != nil {
+		return nil, err
+	}
+	return output(c.Stats(ctx))
+}
+func (e *registryEntry) Jobs(ctx context.Context, in *TargetInput) (*Output[controlplane.RcloneJobs], error) {
+	c, err := e.rclone(in.Target)
+	if err != nil {
+		return nil, err
+	}
+	return output(c.Jobs(ctx))
+}
+func (e *registryEntry) Job(ctx context.Context, in *JobInput) (*Output[controlplane.RcloneJob], error) {
+	c, err := e.rclone(in.Target)
+	if err != nil {
+		return nil, err
+	}
+	return output(c.Job(ctx, in.ID))
+}
+func (e *registryEntry) Stop(ctx context.Context, in *StopInput) (*Output[struct{}], error) {
+	c, err := e.rclone(in.Target)
+	if err != nil {
+		return nil, err
+	}
+	return output(struct{}{}, c.Stop(ctx, in.ID, in.Body.ExecuteID))
+}
+func (e *registryEntry) Probe(ctx context.Context, in *TargetInput) (*Output[controlplane.OriginStatus], error) {
+	if err := e.ready(); err != nil {
+		return nil, err
+	}
+	v, err := e.registry.Probe(ctx, in.Target)
+	if errors.Is(err, controlplane.ErrInvalid) {
+		return nil, rejected(404)
+	}
+	return output(v, err)
+}
+
+// APIConfig supplies the product's JSON compatibility policy to the schema tool.
+func APIConfig() api.Config {
+	return api.Config{
+		Title: "OpenList control management", Version: "1.0.0",
+		OpenAPIPath: "/openapi", SchemasPath: "/schemas",
+		Errors: api.JSONErrors([]int{400, 404, 409, 502, 503}, func(code int) APIError {
+			return APIError{Code: code, Message: http.StatusText(code)}
+		}, func(code int) int {
+			if code == http.StatusRequestEntityTooLarge || code == http.StatusUnprocessableEntity {
+				return http.StatusBadRequest
+			}
+			return code
+		}),
+	}
+}
+
+// RegisterRoutes contributes the named entry methods to the schema effect tool.
+// The same typed contributions generate schemas and drive HTTP publication.
+func (e *registryEntry) RegisterRoutes(table api.RouteTable) error {
+	if err := api.Register[EmptyInput, Output[[]controlplane.Summary]](table, operation("control-targets", "GET", "/targets"), e.Targets); err != nil {
+		return err
+	}
+	if err := api.Register[TargetInput, Output[worker.Manifest]](table, operation("control-worker-manifest", "GET", "/targets/{target}/manifest"), e.Manifest); err != nil {
+		return err
+	}
+	if err := api.Register[TargetInput, Output[[]worker.Observed]](table, operation("control-worker-observed", "GET", "/targets/{target}/observed"), e.Observed); err != nil {
+		return err
+	}
+	if err := api.Register[ReplaceInput, Output[worker.Version]](table, operation("control-worker-replace", "POST", "/targets/{target}/clients/{name}"), e.Replace); err != nil {
+		return err
+	}
+	if err := api.Register[TargetInput, Output[controlplane.RcloneVersion]](table, operation("control-rclone-version", "GET", "/targets/{target}/version"), e.Version); err != nil {
+		return err
+	}
+	if err := api.Register[TargetInput, Output[controlplane.RcloneStats]](table, operation("control-rclone-stats", "GET", "/targets/{target}/stats"), e.Stats); err != nil {
+		return err
+	}
+	if err := api.Register[TargetInput, Output[controlplane.RcloneJobs]](table, operation("control-rclone-jobs", "GET", "/targets/{target}/jobs"), e.Jobs); err != nil {
+		return err
+	}
+	if err := api.Register[JobInput, Output[controlplane.RcloneJob]](table, operation("control-rclone-job", "GET", "/targets/{target}/jobs/{id}"), e.Job); err != nil {
+		return err
+	}
+	if err := api.Register[StopInput, Output[struct{}]](table, operation("control-rclone-stop", "POST", "/targets/{target}/jobs/{id}/stop"), e.Stop); err != nil {
+		return err
+	}
+	if err := api.Register[TargetInput, Output[controlplane.OriginStatus]](table, operation("control-origin-probe", "GET", "/targets/{target}/probe"), e.Probe); err != nil {
+		return err
+	}
+	return api.RegisterRawJSON[DescriptorInput, descriptor.Descriptor](table, operation("control-worker-descriptor", "GET", "/targets/{target}/descriptors/{digest}"), e.Descriptor)
+}
+func operation(id, method, path string) api.Operation {
+	return api.Operation{ID: id, Method: method, Path: path, MaxBodyBytes: controlplane.MaxMetadata, RejectUnknownQueryParameters: true}
+}
diff --git a/internal/controlplane/origins.go b/internal/controlplane/origins.go
new file mode 100644
index 0000000000000000000000000000000000000000..2f6d4d6f542d0942803f44342283e5b2a794c19e
--- /dev/null
+++ b/internal/controlplane/origins.go
@@ -0,0 +1,107 @@
+package controlplane
+
+import (
+	"context"
+	"net/http"
+	"path"
+	"strings"
+	"time"
+
+	"github.com/OpenListTeam/OpenList/v4/pkg/gowebdav"
+	"github.com/aws/aws-sdk-go/aws"
+	"github.com/aws/aws-sdk-go/aws/credentials"
+	"github.com/aws/aws-sdk-go/aws/session"
+	"github.com/aws/aws-sdk-go/service/s3"
+)
+
+// OriginStatus is administrative availability metadata for the initially
+// selected S3 and WebDAV origins, not the legacy OpenList driver inventory or
+// a replacement for Worker-owned plugin capabilities. Probe constructs SDK
+// clients only for an explicit administrator request; inventory stays passive.
+type OriginStatus struct {
+	Kind            string    `json:"kind"`
+	Available       bool      `json:"available"`
+	Bucket          string    `json:"bucket,omitempty"`
+	Region          string    `json:"region,omitempty"`
+	RootIsDirectory bool      `json:"root_is_directory,omitempty"`
+	RootModified    time.Time `json:"root_modified,omitempty"`
+	Allow           []string  `json:"allow,omitempty"`
+}
+
+func (r *Registry) Probe(ctx context.Context, name string) (OriginStatus, error) {
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	target := r.targets[name]
+	if target == nil {
+		return OriginStatus{}, ErrInvalid
+	}
+	cfg := target.config
+	v := OriginStatus{Kind: cfg.Kind}
+	switch cfg.Kind {
+	case "origin-s3":
+		access, e := secret(ctx, r.secrets, cfg.AccessKeySecretRef)
+		if e != nil {
+			return v, e
+		}
+		key, e := secret(ctx, r.secrets, cfg.SecretKeySecretRef)
+		if e != nil {
+			return v, e
+		}
+		token, e := secret(ctx, r.secrets, cfg.SessionTokenSecretRef)
+		if e != nil {
+			return v, e
+		}
+		if access == "" || key == "" {
+			return v, ErrUpstream
+		}
+		sess, e := session.NewSession(aws.NewConfig().WithEndpoint(cfg.Endpoint).WithRegion(cfg.Region).WithS3ForcePathStyle(cfg.ForcePathStyle).WithCredentials(credentials.NewStaticCredentials(access, key, token)).WithHTTPClient(target.http).WithMaxRetries(0))
+		if e != nil {
+			return v, ErrUpstream
+		}
+		if _, e = s3.New(sess).HeadBucketWithContext(ctx, &s3.HeadBucketInput{Bucket: &cfg.Bucket}); e != nil {
+			return v, ErrUpstream
+		}
+		v.Bucket = cfg.Bucket
+		v.Region = cfg.Region
+		v.Available = true
+	case "origin-webdav":
+		root := path.Clean("/" + strings.TrimPrefix(cfg.Root, "/"))
+		u := strings.TrimRight(cfg.Endpoint, "/") + root
+		q, e := http.NewRequestWithContext(ctx, http.MethodOptions, u, nil)
+		if e != nil {
+			return v, ErrInvalid
+		}
+		response, e := target.http.Do(q)
+		if e != nil {
+			return v, ErrUpstream
+		}
+		response.Body.Close()
+		if response.StatusCode < 200 || response.StatusCode >= 300 {
+			return v, ErrUpstream
+		}
+		if len(response.Header.Get("Allow")) > 4096 {
+			return v, ErrUpstream
+		}
+		// Only recognized metadata verbs are projected, never arbitrary headers.
+		for _, method := range strings.Split(response.Header.Get("Allow"), ",") {
+			method = strings.TrimSpace(method)
+			switch method {
+			case "OPTIONS", "PROPFIND", "GET", "HEAD", "PUT", "DELETE", "MKCOL", "MOVE", "COPY", "LOCK", "UNLOCK":
+				v.Allow = append(v.Allow, method)
+			}
+		}
+		d := gowebdav.NewClient(cfg.Endpoint, "", "")
+		d.SetTransport(target.http.Transport)
+		d.SetInterceptor(func(_ string, q *http.Request) { *q = *q.WithContext(ctx) })
+		info, e := d.Stat(root)
+		if e != nil {
+			return v, ErrUpstream
+		}
+		v.RootIsDirectory = info.IsDir()
+		v.RootModified = info.ModTime()
+		v.Available = true
+	default:
+		return v, ErrInvalid
+	}
+	return v, nil
+}
diff --git a/internal/controlplane/rclone.go b/internal/controlplane/rclone.go
new file mode 100644
index 0000000000000000000000000000000000000000..e42daf2b777a8ea278abd25afde7c8885b3cf93a
--- /dev/null
+++ b/internal/controlplane/rclone.go
@@ -0,0 +1,149 @@
+package controlplane
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// RC's public API is projected into finite administrative methods. Error text,
+// output, config/dump and arbitrary invocation are intentionally not exposed.
+// Protocol authority: https://rclone.org/rc/ .
+type Rclone struct {
+	base string
+	http *http.Client
+}
+
+func NewRclone(base string, h *http.Client) (*Rclone, error) {
+	u, e := url.Parse(base)
+	if e != nil || u.Host == "" || u.Scheme != "http" && u.Scheme != "https" || u.User != nil || u.RawQuery != "" || u.Fragment != "" || h == nil {
+		return nil, ErrInvalid
+	}
+	copyClient := *h
+	copyClient.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	if copyClient.Timeout <= 0 || copyClient.Timeout > 30*time.Second {
+		copyClient.Timeout = 30 * time.Second
+	}
+	return &Rclone{strings.TrimRight(base, "/"), &copyClient}, nil
+}
+func (c *Rclone) call(ctx context.Context, method string, input, output any) error {
+	b, e := json.Marshal(input)
+	if e != nil || len(b) > MaxMetadata {
+		return ErrInvalid
+	}
+	q, e := http.NewRequestWithContext(ctx, http.MethodPost, c.base+"/"+method, bytes.NewReader(b))
+	if e != nil {
+		return ErrInvalid
+	}
+	q.Header.Set("Content-Type", "application/json")
+	r, e := c.http.Do(q)
+	if e != nil {
+		return ErrUpstream
+	}
+	defer r.Body.Close()
+	if r.StatusCode != http.StatusOK {
+		return ErrUpstream
+	}
+	b, e = io.ReadAll(io.LimitReader(r.Body, MaxMetadata+1))
+	if e != nil || len(b) > MaxMetadata {
+		return ErrUpstream
+	}
+	if json.Unmarshal(b, output) != nil {
+		return ErrUpstream
+	}
+	return nil
+}
+
+type RcloneVersion struct {
+	Version   string `json:"version"`
+	OS        string `json:"os"`
+	Arch      string `json:"arch"`
+	GoVersion string `json:"goVersion"`
+	IsBeta    bool   `json:"isBeta"`
+}
+
+func (c *Rclone) Version(ctx context.Context) (RcloneVersion, error) {
+	var v RcloneVersion
+	e := c.call(ctx, "core/version", struct{}{}, &v)
+	return v, e
+}
+
+type RcloneStats struct {
+	Bytes       int64   `json:"bytes"`
+	Checks      int64   `json:"checks"`
+	Deletes     int64   `json:"deletes"`
+	Errors      int64   `json:"errors"`
+	Transfers   int64   `json:"transfers"`
+	Speed       float64 `json:"speed"`
+	ElapsedTime float64 `json:"elapsedTime"`
+	FatalError  bool    `json:"fatalError"`
+}
+
+func (c *Rclone) Stats(ctx context.Context) (RcloneStats, error) {
+	var v RcloneStats
+	e := c.call(ctx, "core/stats", struct {
+		Short bool `json:"short"`
+	}{true}, &v)
+	return v, e
+}
+
+type RcloneJobs struct {
+	ExecuteID string  `json:"executeId"`
+	IDs       []int64 `json:"jobids"`
+	Running   []int64 `json:"running_ids"`
+	Finished  []int64 `json:"finished_ids"`
+}
+
+func (c *Rclone) Jobs(ctx context.Context) (RcloneJobs, error) {
+	var v RcloneJobs
+	e := c.call(ctx, "job/list", struct{}{}, &v)
+	return v, e
+}
+
+type RcloneJob struct {
+	ID        int64   `json:"id"`
+	ExecuteID string  `json:"executeId"`
+	Finished  bool    `json:"finished"`
+	Success   bool    `json:"success"`
+	Duration  float64 `json:"duration"`
+	StartTime string  `json:"startTime"`
+	EndTime   string  `json:"endTime"`
+}
+
+func (c *Rclone) Job(ctx context.Context, id int64) (RcloneJob, error) {
+	var v RcloneJob
+	if id <= 0 {
+		return v, ErrInvalid
+	}
+	e := c.call(ctx, "job/status", struct {
+		ID int64 `json:"jobid"`
+	}{id}, &v)
+	if e == nil && v.ID != id {
+		return RcloneJob{}, ErrUpstream
+	}
+	return v, e
+}
+func (c *Rclone) Stop(ctx context.Context, id int64, executeID string) error {
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	if id <= 0 || executeID == "" || len(executeID) > 128 {
+		return ErrInvalid
+	}
+	job, e := c.Job(ctx, id)
+	if e != nil {
+		return e
+	}
+	if job.ExecuteID != executeID {
+		return ErrConflict
+	}
+	// RC stop has no atomic execute-ID precondition. This check catches stale UI
+	// submissions, but an external process restart can race the subsequent call.
+	return c.call(ctx, "job/stop", struct {
+		ID int64 `json:"jobid"`
+	}{id}, &struct{}{})
+}
diff --git a/server/controlplane_test.go b/server/controlplane_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..65ce1d2ff9cd669048f59f22163fba5fffc0530b
--- /dev/null
+++ b/server/controlplane_test.go
@@ -0,0 +1,90 @@
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/OpenListTeam/OpenList/v4/internal/conf"
+	"github.com/OpenListTeam/OpenList/v4/internal/controlplane"
+	"github.com/OpenListTeam/OpenList/v4/internal/model"
+	"github.com/OpenListTeam/OpenList/v4/server/middlewares"
+	"github.com/gin-gonic/gin"
+)
+
+func TestControlManagementRegisteredInsideExistingAdminBoundary(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	old := conf.Conf
+	defer func() { conf.Conf = old }()
+	conf.Conf = conf.DefaultConfig(t.TempDir())
+	p := filepath.Join(t.TempDir(), "control-targets")
+	b, _ := json.Marshal(controlplane.Config{Targets: []controlplane.Target{{Name: "backup", Kind: "rclone", Endpoint: "http://127.0.0.1:1"}}})
+	if e := os.WriteFile(p, b, 0600); e != nil {
+		t.Fatal(e)
+	}
+	conf.Conf.ControlTargetsFile = p
+	e := gin.New()
+	group := e.Group("/api/admin", func(c *gin.Context) {
+		role := model.GUEST
+		if c.GetHeader("X-Test-Administrator") == "yes" {
+			role = model.ADMIN
+		}
+		c.Request = c.Request.WithContext(context.WithValue(c.Request.Context(), conf.UserKey, &model.User{Role: role}))
+	}, middlewares.AuthAdmin)
+	admin(e, group)
+	for _, allowed := range []bool{false, true} {
+		q := httptest.NewRequest("GET", "/api/admin/control/targets", nil)
+		if allowed {
+			q.Header.Set("X-Test-Administrator", "yes")
+		}
+		w := httptest.NewRecorder()
+		e.ServeHTTP(w, q)
+		var body struct {
+			Code int             `json:"code"`
+			Data json.RawMessage `json:"data"`
+		}
+		if er := json.Unmarshal(w.Body.Bytes(), &body); er != nil {
+			t.Fatal(er, w.Body)
+		}
+		if !allowed && body.Code != 403 {
+			t.Fatal("existing administrator middleware was bypassed", w.Code, w.Body)
+		}
+		if allowed && (body.Code != 200 || !strings.Contains(string(body.Data), `"name":"backup"`)) {
+			t.Fatal("registered management route unavailable", w.Code, w.Body)
+		}
+	}
+	for _, metadataPath := range []string{"/openapi.json", "/schemas/StopRequest.json"} {
+		for _, allowed := range []bool{false, true} {
+			q := httptest.NewRequest("GET", "/api/admin/control"+metadataPath, nil)
+			if allowed {
+				q.Header.Set("X-Test-Administrator", "yes")
+			}
+			w := httptest.NewRecorder()
+			e.ServeHTTP(w, q)
+			if allowed {
+				if w.Code != 200 || (metadataPath == "/openapi.json" && !strings.Contains(w.Body.String(), `"openapi":"3.1.0"`)) || (metadataPath != "/openapi.json" && !strings.Contains(w.Body.String(), `"execute_id"`)) {
+					t.Fatal("administrator generated OpenAPI unavailable", w.Code, w.Body)
+				}
+			} else {
+				var denied struct {
+					Code int `json:"code"`
+				}
+				json.Unmarshal(w.Body.Bytes(), &denied)
+				if denied.Code != 403 {
+					t.Fatal("schema route bypassed administrator authorization", w.Code, w.Body)
+				}
+			}
+		}
+	}
+	registered := false
+	for _, route := range e.Routes() {
+		registered = registered || route.Method == "GET" && route.Path == "/api/admin/control/targets"
+	}
+	if !registered {
+		t.Fatal("typed management operation not registered in Gin administrator group")
+	}
+}
