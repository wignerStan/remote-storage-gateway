index 0000000000000000000000000000000000000000..04c94f349d23b0c410217df4f3ab9bf052aaf3a5
--- /dev/null
+++ b/pluginentry/entry.go
@@ -0,0 +1,60 @@
+// Package pluginentry owns native OpenList plugin publication and schema derivation.
+package pluginentry
+
+import (
+	"encoding/json"
+
+	"github.com/OpenListTeam/OpenList/v4/clientplugin"
+	"github.com/wignerStan/infra/go/code/schema"
+	port "github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/client"
+	"github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/descriptor"
+	"github.com/wignerStan/network-data-plane-worker/go/contracts/plugin/descriptor/admission"
+)
+
+type ProviderConfigurationSchemas struct {
+	S3     schema.Document
+	WebDAV schema.Document
+}
+
+// ConfigurationSchemas derives this plugin's implementation-owned public models
+// at its publication entry. It performs no provider initialization or I/O.
+func ConfigurationSchemas() (ProviderConfigurationSchemas, error) {
+	s3, err := schema.Derive[clientplugin.S3Configuration](schema.Identity{ID: "client.openlist/configuration/s3", Version: "1", Owner: clientplugin.PluginID})
+	if err != nil {
+		return ProviderConfigurationSchemas{}, err
+	}
+	dav, err := schema.Derive[clientplugin.WebDAVConfiguration](schema.Identity{ID: "client.openlist/configuration/webdav", Version: "1", Owner: clientplugin.PluginID})
+	if err != nil {
+		return ProviderConfigurationSchemas{}, err
+	}
+	return ProviderConfigurationSchemas{S3: s3, WebDAV: dav}, nil
+}
+
+// NewFactory publishes a concrete descriptor once, then injects its immutable
+// values into the runtime handler. Worker remains the descriptor contract owner.
+func NewFactory(buildDigest string) (*clientplugin.Factory, error) {
+	schemas, err := ConfigurationSchemas()
+	if err != nil {
+		return nil, err
+	}
+	s3, err := json.Marshal(schemas.S3.Schema)
+	if err != nil {
+		return nil, err
+	}
+	dav, err := json.Marshal(schemas.WebDAV.Schema)
+	if err != nil {
+		return nil, err
+	}
+	published := descriptor.Descriptor{
+		Schema: descriptor.Schema, PluginID: clientplugin.PluginID, PluginVersion: clientplugin.Version,
+		Contract: port.Contract, Runtime: "go", BuildDigest: buildDigest,
+		Implementations: []descriptor.Implementation{
+			{ID: "s3", DisplayName: "OpenList S3", ConfigSchema: s3, Capabilities: []string{"stat", "list", "open", "put", "delete", "range", "unknown-size-put", "list-pagination"}},
+			{ID: "webdav", DisplayName: "OpenList WebDAV", ConfigSchema: dav, Capabilities: []string{"stat", "list", "open", "put", "delete", "range", "unknown-size-put"}},
+		},
+	}
+	if err = admission.Validate(published); err != nil {
+		return nil, err
+	}
+	return clientplugin.NewFactory(published), nil
+}
