+func TestCachePerInstanceDirectories(t *testing.T) {
+	r := fstest.NewRun(t)
+	globalDir := config.GetCacheDir()
+	var roots []string
+	for range 2 {
+		opt := vfscommon.Opt
+		opt.CacheDir = t.TempDir()
+		opt.CachePollInterval = 0
+		opt.WriteBack = 0
+		ctx, cancel := context.WithCancel(context.Background())
+		cache, err := New(ctx, r.Fremote, &opt, nil)
+		require.NoError(t, err)
+		t.Cleanup(func() {
+			cancel()
+			require.NoError(t, cache.CleanUp())
+		})
+		assert.Equal(t, opt.CacheDir, cache.cacheDir)
+		for _, root := range []string{cache.root, cache.metaRoot} {
+			relative, err := filepath.Rel(opt.CacheDir, root)
+			require.NoError(t, err)
+			assert.False(t, filepath.IsAbs(relative) || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)))
+			assertPathExist(t, root)
+		}
+		roots = append(roots, cache.root)
+		assert.Equal(t, globalDir, config.GetCacheDir(), "per-cache selection changed process configuration")
+	}
+	assert.NotEqual(t, roots[0], roots[1])
+}
