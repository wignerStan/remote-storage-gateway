+func TestVFSNewPerInstanceCacheDirectories(t *testing.T) {
+	r := fstest.NewRun(t)
+	globalDir := config.GetCacheDir()
+	opt := vfscommon.Opt
+	opt.ReadOnly = true
+	opt.CacheMode = vfscommon.CacheModeFull
+	opt.CachePollInterval = 0
+	opt.CacheDir = t.TempDir()
+	first := New(context.Background(), r.Fremote, &opt)
+	t.Cleanup(func() { cleanupVFS(t, first) })
+	next := opt
+	next.CacheDir = t.TempDir()
+	second := New(context.Background(), r.Fremote, &next)
+	t.Cleanup(func() { cleanupVFS(t, second) })
+	require.NotSame(t, first, second, "active VFS identity ignored its cache directory")
+	require.NotNil(t, first.cache)
+	require.NotNil(t, second.cache)
+	assert.NotSame(t, first.cache, second.cache)
+
+	// Equal directories still reuse the active instance, retaining the normal
+	// upstream cache identity and reference-counting behavior.
+	shared := New(context.Background(), r.Fremote, &opt)
+	require.Same(t, first, shared)
+	shared.Shutdown()
+	for _, directory := range []string{opt.CacheDir, next.CacheDir} {
+		info, err := os.Stat(filepath.Join(directory, "vfs"))
+		require.NoError(t, err)
+		assert.True(t, info.IsDir())
+	}
+	assert.Equal(t, globalDir, config.GetCacheDir())
+}
