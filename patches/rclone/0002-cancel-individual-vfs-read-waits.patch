+type gatedObject struct {
+	fs.Object
+	gate    <-chan struct{}
+	started chan struct{}
+	once    sync.Once
+}
+
+func (o *gatedObject) Open(ctx context.Context, options ...fs.OpenOption) (io.ReadCloser, error) {
+	body, err := o.Object.Open(ctx, options...)
+	if err != nil {
+		return nil, err
+	}
+	return &gatedReadCloser{ReadCloser: body, ctx: ctx, owner: o}, nil
+}
+
+type gatedReadCloser struct {
+	io.ReadCloser
+	ctx   context.Context
+	owner *gatedObject
+}
+
+func (r *gatedReadCloser) Read(p []byte) (int, error) {
+	r.owner.once.Do(func() { close(r.owner.started) })
+	select {
+	case <-r.owner.gate:
+		return r.ReadCloser.Read(p)
+	case <-r.ctx.Done():
+		return 0, r.ctx.Err()
+	}
+}
+
+func TestDownloadContextDoesNotCancelPeer(t *testing.T) {
+	r := fstest.NewRun(t)
+	ctx := context.Background()
+	const size = int64(1024 * 1024)
+	src, err := operations.RcatSize(ctx, r.Fremote, "context.txt", io.NopCloser(readers.NewPatternReader(size)), size, time.Now(), nil)
+	require.NoError(t, err)
+	gate, started := make(chan struct{}), make(chan struct{})
+	var release sync.Once
+	item := &testItem{t: t, size: size}
+	opt := vfscommon.Opt
+	dls := New(ctx, item, &opt, "context.txt", &gatedObject{Object: src, gate: gate, started: started})
+	t.Cleanup(func() { release.Do(func() { close(gate) }); assert.NoError(t, dls.Close(nil)) })
+	firstCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	first, peer := make(chan error, 1), make(chan error, 1)
+	rangeWanted := ranges.Range{Pos: 0, Size: 100}
+	go func() { first <- dls.DownloadContext(firstCtx, rangeWanted) }()
+	go func() { peer <- dls.DownloadContext(ctx, rangeWanted) }()
+	select {
+	case <-started:
+	case <-time.After(3 * time.Second):
+		t.Fatal("shared downloader did not start")
+	}
+	require.Eventually(t, func() bool { dls.mu.Lock(); defer dls.mu.Unlock(); return len(dls.waiters) == 2 }, 3*time.Second, time.Millisecond)
+	cancel()
+	select {
+	case err := <-first:
+		require.ErrorIs(t, err, context.Canceled)
+	case <-time.After(time.Second):
+		t.Fatal("canceled waiter blocked")
+	}
+	dls.mu.Lock()
+	waiterCount := len(dls.waiters)
+	dls.mu.Unlock()
+	require.Equal(t, 1, waiterCount)
+	require.NoError(t, dls.ctx.Err())
+	select {
+	case err := <-peer:
+		t.Fatalf("peer stopped with canceled caller: %v", err)
+	default:
+	}
+	release.Do(func() { close(gate) })
+	select {
+	case err := <-peer:
+		require.NoError(t, err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("peer did not receive shared download")
+	}
+	dls.mu.Lock()
+	waiterCount = len(dls.waiters)
+	dls.mu.Unlock()
+	require.Zero(t, waiterCount)
+}
+
+func TestDownloadersCloseCancelsBlockedInput(t *testing.T) {
+	r := fstest.NewRun(t)
+	ctx := context.Background()
+	const size = int64(1024 * 1024)
+	src, err := operations.RcatSize(ctx, r.Fremote, "close-context.txt", io.NopCloser(readers.NewPatternReader(size)), size, time.Now(), nil)
+	require.NoError(t, err)
+	gate, started := make(chan struct{}), make(chan struct{})
+	var release sync.Once
+	opt := vfscommon.Opt
+	dls := New(ctx, &testItem{t: t, size: size}, &opt, "close-context.txt", &gatedObject{Object: src, gate: gate, started: started})
+	t.Cleanup(func() { release.Do(func() { close(gate) }); _ = dls.Close(context.Canceled) })
+	readDone := make(chan error, 1)
+	go func() { readDone <- dls.DownloadContext(ctx, ranges.Range{Pos: 0, Size: 1}) }()
+	select {
+	case <-started:
+	case <-time.After(3 * time.Second):
+		t.Fatal("download did not block in backend input")
+	}
+	closed := make(chan error, 1)
+	go func() { closed <- dls.Close(context.Canceled) }()
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		release.Do(func() { close(gate) })
+		t.Fatal("Close joined blocked input before canceling it")
+	}
+	select {
+	case err := <-readDone:
+		require.ErrorIs(t, err, context.Canceled)
+	case <-time.After(time.Second):
+		t.Fatal("Close retained download waiter")
+	}
+	require.ErrorIs(t, dls.ctx.Err(), context.Canceled)
+}
