+func TestRWFileHandleReadContext(t *testing.T) {
+	_, _, fh := rwHandleCreateReadOnly(t)
+	defer fh.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	buffer := make([]byte, 1)
+	n, err := fh.ReadContext(ctx, buffer)
+	require.Zero(t, n)
+	require.ErrorIs(t, err, context.Canceled)
+	n, err = fh.ReadAtContext(ctx, buffer, 0)
+	require.Zero(t, n)
+	require.ErrorIs(t, err, context.Canceled)
+	n, err = fh.Read(buffer)
+	require.NoError(t, err)
+	require.Equal(t, 1, n)
+	require.Equal(t, byte('0'), buffer[0], "canceled sequential read must not advance offset")
+}
