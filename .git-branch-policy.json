{
  "schema_version": "git-branch-policy/v3",
  "types": [
    "build",
    "chore",
    "ci",
    "docs",
    "feat",
    "fix",
    "migrate",
    "perf",
    "refactor",
    "revert",
    "style",
    "test"
  ],
  "release_lanes": {
    "testing": {
      "stage": "alpha",
      "channel": "alpha"
    },
    "develop": {
      "stage": "beta",
      "channel": "project-latest"
    },
    "main": {
      "stage": "stable",
      "channel": "stable"
    }
  },
  "promotion_order": [
    "testing",
    "develop",
    "main"
  ],
  "repository_owner": "repo",
  "owners": {}
}
