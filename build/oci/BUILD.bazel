load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@native_inputs//:provenance.bzl", "GATEWAY_SOURCE", "RCLONE_SOURCE")

platform(
    name = "linux_x86_64",
    constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    exec_properties = {
        "OSFamily": "Linux",
        "container-image": "docker://localhost/infra-rust-builder@sha256:2ebf13498c35c09fb653bc6c3a74032efdbd64a975532e722a2080f7cc87ac5b",
        "execution-location": "incus",
    },
)

image_layer(
    name = "trust_and_provenance",
    srcs = {
        "/etc/ssl/certs/ca-certificates.crt": "@native_inputs//:ca-certificates.crt",
        "/usr/share/storage-gateway/assembly.json": "@native_inputs//:assembly.json",
        "/usr/share/storage-gateway/gateway-native-release.json": "@native_inputs//:gateway-native-release.json",
        "/usr/share/storage-gateway/rclone-native-build.json": "@native_inputs//:rclone-native-build.json",
    },
    default_metadata = file_metadata(mode = "0444", uid = 0, gid = 0),
    include_runfiles = False,
)

image_layer(
    name = "bundle_programs",
    srcs = {
        "/opt/gateway/gateway": "@native_inputs//:gateway",
        "/opt/materializer/rclone": "@native_inputs//:rclone",
        "/opt/gateway/client-openlist.so": "@native_inputs//:client-openlist.so",
        "/opt/gateway/client-rclone.so": "@native_inputs//:client-rclone.so",
        "/opt/gateway/transfer-reapi.so": "@native_inputs//:transfer-reapi.so",
    },
    default_metadata = file_metadata(mode = "0555", uid = 0, gid = 0),
    include_runfiles = False,
)
image_manifest(
    name = "bundle_image",
    base = "@runtime",
    layers = [":bundle_programs", ":trust_and_provenance"],
    user = "1001:1001",
    entrypoint = ["/opt/gateway/gateway"],
    cmd = ["manager", "--config", "/run/control-secrets/bundle.json"],
    working_dir = "/",
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/wignerStan/remote-storage-gateway", "org.opencontainers.image.revision": GATEWAY_SOURCE},
)
image_layer(
    name = "worker_programs",
    srcs = {
        "/opt/gateway/storage-worker": "@native_inputs//:storage-worker",
        "/opt/gateway/client-openlist.so": "@native_inputs//:client-openlist.so",
        "/opt/gateway/client-rclone.so": "@native_inputs//:client-rclone.so",
        "/opt/gateway/transfer-reapi.so": "@native_inputs//:transfer-reapi.so",
    },
    default_metadata = file_metadata(mode = "0555", uid = 0, gid = 0),
    include_runfiles = False,
)
image_manifest(
    name = "gateway_image",
    base = "@runtime",
    layers = [":worker_programs", ":trust_and_provenance"],
    user = "1001:1001",
    entrypoint = ["/opt/gateway/storage-worker"],
    cmd = ["-config", "/run/gateway-secrets/gateway.json"],
    working_dir = "/",
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/wignerStan/remote-storage-gateway", "org.opencontainers.image.revision": GATEWAY_SOURCE},
)
image_layer(
    name = "control_plane_program",
    srcs = {"/opt/control-plane/openlist": "@native_inputs//:openlist-control-plane"},
    default_metadata = file_metadata(mode = "0555", uid = 0, gid = 0),
    include_runfiles = False,
)
image_manifest(
    name = "control_plane_image",
    base = "@runtime",
    layers = [":control_plane_program", ":trust_and_provenance"],
    user = "1001:1001",
    entrypoint = ["/opt/control-plane/openlist"],
    cmd = ["server", "--data", "/run/control-state", "--config", "/run/control-state/config.json"],
    working_dir = "/",
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/wignerStan/remote-storage-gateway", "org.opencontainers.image.revision": GATEWAY_SOURCE},
)
image_layer(
    name = "rclone_program",
    srcs = {"/opt/rclone/rclone": "@native_inputs//:rclone"},
    default_metadata = file_metadata(mode = "0555", uid = 0, gid = 0),
    include_runfiles = False,
)
image_manifest(
    name = "rclone_image",
    base = "@runtime",
    layers = [":rclone_program", ":trust_and_provenance"],
    user = "1001:1001",
    entrypoint = ["/opt/rclone/rclone"],
    cmd = ["serve", "managed-vfs", "--config=/dev/null", "--managed-config=/run/materializer/config.json"],
    working_dir = "/",
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/wignerStan/rclone", "org.opencontainers.image.revision": RCLONE_SOURCE},
)
