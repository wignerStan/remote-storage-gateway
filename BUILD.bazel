load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
platform(name = "linux_x86_64", constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"])
image_layer(
    name = "gateway_programs",
    srcs = {
        "/opt/gateway/remote-storage-gateway": "@runtime_inputs//:remote-storage-gateway",
        "/opt/gateway/client-openlist.so": "@runtime_inputs//:client-openlist.so",
        "/opt/gateway/client-rclone.so": "@runtime_inputs//:client-rclone.so",
    },
    default_metadata = file_metadata(mode = "0555", uid = 1001, gid = 1001),
    include_runfiles = False,
)
image_layer(
    name = "gateway_trust",
    srcs = {"/etc/ssl/certs/ca-certificates.crt": "@runtime_inputs//:ca-certificates.crt"},
    default_metadata = file_metadata(mode = "0644", uid = 0, gid = 0),
    include_runfiles = False,
)
image_manifest(
    name = "gateway_image",
    base = "@gateway_runtime",
    layers = [":gateway_programs", ":gateway_trust"],
    user = "1001:1001",
    entrypoint = ["/opt/gateway/remote-storage-gateway"],
    cmd = ["-config", "/run/gateway-secrets/gateway.json"],
    working_dir = "/",
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/wignerStan/remote-storage-gateway"},
)
image_layer(
    name = "control_plane_program",
    srcs = {
        "/opt/control-plane/openlist": "@control_plane_inputs//:openlist-control-plane",
        "/opt/openlist/.keep": "@control_plane_inputs//:_working_directory",
    },
    default_metadata = file_metadata(mode = "0555", uid = 0, gid = 0),
    file_metadata = {"/opt/openlist/.keep": file_metadata(mode = "0444", uid = 0, gid = 0)},
    include_runfiles = False,
)
image_layer(
    name = "control_plane_trust",
    srcs = {"/etc/ssl/certs/ca-certificates.crt": "@control_plane_inputs//:ca-certificates.crt"},
    default_metadata = file_metadata(mode = "0444", uid = 0, gid = 0),
    include_runfiles = False,
)
image_manifest(
    name = "control_plane_image",
    base = "@gateway_runtime",
    layers = [":control_plane_program", ":control_plane_trust"],
    user = "1001:1001",
    entrypoint = ["/opt/control-plane/openlist"],
    cmd = ["server", "--data", "/opt/openlist/data", "--config", "/opt/openlist/data/config.json"],
    working_dir = "/opt/openlist",
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/wignerStan/remote-storage-gateway"},
)
